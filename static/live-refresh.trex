<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.andrewhill.live-refresh" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name" />
    <description>Auto-refreshes every data source on the dashboard at a configurable interval.</description>
    <author name="Demo Studio" email="noreply@example.com" organization="local" website="https://example.com/" />
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>http://localhost:3777/static/extension.html</url>
    </source-location>
    <icon>iVBORw0KGgoAAAANSUhEUgAAACAAAAAgCAYAAABzenr0AAAAGklEQVRYhe3BAQ0AAADCoPdPbQ8HFAAAAHwYBFsAAQKf1o4AAAAASUVORK5CYII=</icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Live Refresh</text>
    </resource>
  </resources>
</manifest>
